{
    "markdown-pdf.styles": [
        ".vscode/markdown-pdf.css"
    ],
    "markdown-pdf.stylesRelativePathFile": false,
    "markdown-pdf.format": "A4",
    "markdown-pdf.margin.top": "22mm",
    "markdown-pdf.margin.bottom": "22mm",
    "markdown-pdf.margin.left": "18mm",
    "markdown-pdf.margin.right": "18mm",
    "markdown-pdf.displayHeaderFooter": true,
    "markdown-pdf.headerTemplate": "<div style=\"font-size: 8pt; font-family: -apple-system, sans-serif; color: #888888; width: 100%; text-align: right; padding-right: 18mm;\"><span class=\"title\"></span></div>",
    "markdown-pdf.footerTemplate": "<div style=\"font-size: 8.5pt; font-family: -apple-system, sans-serif; color: #777777; width: 100%; display: flex; justify-content: space-between; padding: 0 18mm;\"><span>VedaVMS Documentation</span><span>Page <span class=\"pageNumber\"></span> of <span class=\"totalPages\"></span></span></div>"
}
